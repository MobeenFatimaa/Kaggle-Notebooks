ecute_reply":"2026-10-25T05:57:59.863976Z"},"papermill":{"duration":0.057837,"end_time":"2026-10-25T05:57:59.86678+00:00","exception":false,"start_time":"2026-10-25T05:57:59.808943+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Not enough usable labelled images for a reliable train/test split.\n"]}],"source":["X_train = X_test = y_train = y_test = None\n","if SKLEARN_READY and len(y_labels) >= 10 and len(np.unique(y_labels)) >= 2:\n","    label_encoder = LabelEncoder()\n","    y_encoded = label_encoder.fit_transform(y_labels)\n","    counts = Counter(y_encoded)\n","    can_stratify = min(counts.values()) >= 2\n","    try:\n","        X_train, X_test, y_train, y_test = train_test_split(\n","            X_features, y_encoded, test_size=0.25, random_state=SEED,\n","            stratify=y_encoded if can_stratify else None\n","        )\n","    except ValueError:\n","        X_train, X_test, y_train, y_test = train_test_split(\n","            X_features, y_encoded, test_size=0.25, random_state=SEED\n","        )\n","    print(\"Train:\", X_train.shape, \"| Test:\", X_test.shape)\n","else:\n","    print(\"Not enough usable labelled images for a reliable train/test split.\")"]},{"cell_type":"markdown","id":"c03159d3","metadata":{"papermill":{"duration":0.048782,"end_time":"2026-10-25T05:57:59.964408+00:00","exception":false,"start_time":"2026-10-25T05:57:59.915626+00:00","status":"completed"},"tags":[]},"source":["## 32 · Train a linear SVM baseline\n","A linear support-vector classifier is a quick reference point for HOG features. It is not expected to match a well-tuned CNN on complex image datasets."]},{"cell_type":"code","execution_count":32,"id":"7f05e00e","metadata":{"execution":{"iopub.execute_input":"2026-10-25T05:58:00.070313Z","iopub.status.busy":"2026-10-25T05:58:00.069981Z","iopub.status.idle":"2026-10-25T05:58:00.076545Z","shell.execute_reply":"2026-10-25T05:58:00.075383Z"},"papermill":{"duration":0.063552,"