end_time":"2026-10-01T07:02:32.032599+00:00","exception":false,"start_time":"2026-10-01T07:02:30.357924+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["After digit features: (668665, 77)\n"]}],"source":["def add_digit_features(train_df, test_df, cols):\n","    tr, te = train_df.copy(), test_df.copy()\n","    for c in cols:\n","        a = pd.to_numeric(tr[c], errors=\"coerce\").fillna(0).to_numpy()\n","        b = pd.to_numeric(te[c], errors=\"coerce\").fillna(0).to_numpy()\n","        aa = np.abs(a); bb = np.abs(b)\n","        for k in range(4):\n","            base = 10.0 ** k\n","            tr[f\"{c}__d{k}\"] = (np.floor(aa / base) % 10).astype(np.int8)\n","            te[f\"{c}__d{k}\"] = (np.floor(bb / base) % 10).astype(np.int8)\n","        for k in (1, 2):\n","            tr[f\"{c}__fd{k}\"] = (np.floor(aa * (10.0 ** k)) % 10).astype(np.int8)\n","            te[f\"{c}__fd{k}\"] = (np.floor(bb * (10.0 ** k)) % 10).astype(np.int8)\n","    return tr, te\n","\n","digit_cols = numeric_cols\n","train_f, test_f = add_digit_features(train_f, test_f, digit_cols)\n","print(\"After digit features:\", train_f.shape)"]},{"cell_type":"markdown","id":"7beeaacc","metadata":{"papermill":{"duration":0.008476,"end_time":"2026-10-01T07:02:32.049817+00:00","exception":false,"start_time":"2026-10-01T07:02:32.041341+00:00","status":"completed"},"tags":[]},"source":["## 8. Add frequency encodings for the new digit features"]},{"cell_type":"code","execution_count":9,"id":"9ad0297d","metadata":{"execution":{"iopub.execute_input":"2026-10-01T07:02:32.068451Z","iopub.status.busy":"2026-10-01T07:02:32.068013Z","iopub.status.idle":"2026-10-01T07:02:32.795283Z","shell.execute_reply":"2026-10-01T07:02:32.794253Z"},"papermill":{"duration":0.73927,"end_time":"2026-10-01T07:02:32.797383+00:00","exception":false,"start_time":"2026-10-01T07:02:32.058113+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Final engineered columns: 119\n"]}],"source":["digit_feature_cols = [c for c in train_f.columns if \"__d\" in c or \"__fd\" in c]\n","for c in digit_feature_cols:\n","    vals = pd.concat([train_f[c], test_f[c]], ignore_index=True)\n","    freq = vals.value_counts(dropna=False)\n","    train_f[c + \"__freq\"] = train_f[c].map(freq).astype(np.float32)\n","    test_f[c + \"__freq\"] = test_f[c].map(freq).astype(np.float32)\n","    del vals, freq\n","print(\"Final engineered columns:\", train_f.shape[1])"]},{"cell_type":"markdown","id":"c1ec0706","metadata":{"papermill":{"duration":0.008199,"end_time":"2026-10-01T07:02:32.814065+00:00","exception":false,"start_time":"2026-10-01T07:02:32.805866+00:00","status":"completed"},"tags":[]},"source":["## 9. Encode categorical variables consistently"]},{"cell_type":"code","execution_count":10,"id":"d3088e94","metadata":{"execution":{"iopub.execute_input":"2026-10-01T07:02:32.832647Z","iopub.status.busy":"2026-10-01T07:02:32.831903Z","iopub.status.idle":"2026-10-01T07:02:33.972273Z","shell.execute_reply":"2026-10-01T07:02:33.971231Z"},"papermill":{"duration":1.152425,"end_time":"2026-10-01T07:02:33.974698+00:00","exception":false,"start_time":"2026-10-01T07:02:32.822273+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Model matrix: (668665, 118) (286571, 118)\n"]}],"source":["model_base_cols = [c for c in train_f.columns if c != \"id\"]\n","cat_encode_cols = categorical_cols\n","\n","for c in cat_encode_cols:\n","    all_values = pd.concat([train_f[c].astype(str), test_f[c].astype(str)], ignore_index=True)\n","    codes, _ = pd.factorize(all_values, sort=True)\n","    train_f[c] = codes[:len(train_f)].astype(np.int16)\n","    test_f[c] = codes[len(train_f):].astype(np.int16)\n","    del all_values, codes\n","\n","X = train_f.drop(columns=[\"id\"]).astype(np.float32)\n","X_test = test_f.drop(columns=[\"id\"]).astype(np.float32)\n","print(\"Model matrix:\", X.shape, X_tes