ull), dtype=np.float64)\n","pred_lr = np.zeros(len(X_test_full), dtype=np.float64)\n","\n","for fold, (tr_idx, va_idx) in enumerate(folds, 1):\n","    print(f\"LR fold {fold}/{N_SPLITS}\")\n","    scaler = StandardScaler()\n","    A = scaler.fit_transform(X_full.iloc[tr_idx][linear_cols])\n","    B = scaler.transform(X_full.iloc[va_idx][linear_cols])\n","    T = scaler.transform(X_test_full[linear_cols])\n","    lr = LogisticRegression(C=0.35, max_iter=250, solver=\"lbfgs\", n_jobs=-1)\n","    lr.fit(A, y[tr_idx])\n","    oof_lr[va_idx] = lr.predict_proba(B)[:, 1]\n","    pred_lr += lr.predict_proba(T)[:, 1] / N_SPLITS\n","    del scaler, A, B, T, lr\n","    gc.collect()\n","\n","print(\"LR OOF AUC:\", roc_auc_score(y, oof_lr))"]},{"cell_type":"markdown","id":"05f37e10","metadata":{"papermill":{"duration":0.010229,"end_time":"2026-10-01T08:07:13.606985+00:00","exception":false,"start_time":"2026-10-01T08:07:13.596756+00:00","status":"completed"},"tags":[]},"source":["## 18. Compare individual models"]},{"cell_type":"code","execution_count":19,"id":"f0411a13","metadata":{"execution":{"iopub.execute_input":"2026-10-01T08:07:13.629126Z","iopub.status.busy":"2026-10-01T08:07:13.628796Z","iopub.status.idle":"2026-10-01T08:07:14.359814Z","shell.execute_reply":"2026-10-01T08:07:14.358904Z"},"papermill":{"duration":0.744628,"end_time":"2026-10-01T08:07:14.361892+00:00","exception":false,"start_time":"2026-10-01T08:07:13.617264+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Model</th>\n","      <th>OOF_AUC</th>\n","    </tr>\n","  </t