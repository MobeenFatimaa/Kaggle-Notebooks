_oof_te(base_train, base_test, y, cols, folds, smoothing=20.0):\n","    global_mean = float(y.mean())\n","    oof = pd.DataFrame(index=base_train.index)\n","    tst = pd.DataFrame(index=base_test.index)\n","    for c in cols:\n","        oof_col = np.zeros(len(base_train), dtype=np.float32)\n","        for tr_idx, va_idx in folds:\n","            tmp = pd.DataFrame({\"key\": base_train.iloc[tr_idx][c].to_numpy(), \"target\": y[tr_idx]})\n","            stats = tmp.groupby(\"key\")[\"target\"].agg([\"mean\", \"count\"])\n","            enc = (stats[\"mean\"] * stats[\"count\"] + global_mean * smoothing) / (stats[\"count\"] + smoothing)\n","            oof_col[va_idx] = base_train.iloc[va_idx][c].map(enc).fillna(global_mean).to_numpy(dtype=np.float32)\n","        oof[c + \"__te\"] = oof_col\n","        full = pd.DataFrame({\"key\": base_train[c].to_numpy(), \"target\": y})\n","        stats = full.groupby(\"key\")[\"target\"].agg([\"mean\", \"count\"])\n","        enc = (stats[\"mean\"] * stats[\"count\"] + global_mean * smoothing) / (stats[\"count\"] + smoothing)\n","        tst[c + \"__te\"] = base_test[c].map(enc).fillna(global_mean).to_numpy(dtype=np.float32)\n","    return oof, tst\n","\n","te_train, te_test = make_oof_te(train.drop(columns=[TARGET]), test, y, te_cols, folds, smoothing=20.0)\n","print(te_train.shape, te_test.shape)"]},{"cell_type":"markdown","id":"bbf954ca","metadata":{"papermill":{"duration":0.008748,"end_time":"2026-10-01T07:02:58.527918+00:00","exception":false,"start_time":"2026-10-01T07:02:58.51917+00:00","status":"completed"},"tags":[]},"source":["## 13. Append the OOF target encodings"]},{"cell_type":"code","execution_count":14,"id":"9835abed","metadata":{"execution":{"iopub.execute_input":"2026-10-01T07:02:58.547361Z","iopub.status.busy":"2026-10-01T07:02:58.547028Z","iopub.status.idle":"2026-10-01T07:02:59.434379Z","shell.execute_reply":"2026-10-01T07:02:59.433217Z"},"papermill":{"duration":0.899502,"end_time":"2026-10-01T07:02:59.436325