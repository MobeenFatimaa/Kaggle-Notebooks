pha=0.95\n","        )\n","        mean_score = scores.mean()\n","        median_score = scores.median()\n","        ax.axvline(\n","            mean_score,\n","            color=\"#F87171\",\n","            linestyle=\"--\",\n","            linewidth=2,\n","            label=f\"Mean: {mean_score:.2f}\"\n","        )\n","        ax.axvline(\n","            median_score,\n","            color=\"#4ADE80\",\n","            linestyle=\":\",\n","            linewidth=2,\n","            label=f\"Median: {median_score:.2f}\"\n","        )\n","        ax.set_title(\n","            \"Per-Puzzle Score Distribution Across 1,000 Puzzles\",\n","            fontsize=15,\n","            fontweight=\"bold\",\n","            color=\"white\",\n","            pad=18\n","        )\n","        ax.set_xlabel(\"Puzzle Score\", fontsize=12, color=\"white\")\n","        ax.set_ylabel(\"Number of Puzzles\", fontsize=12, color=\"white\")\n","        ax.tick_params(colors=\"white\")\n","        ax.grid(axis=\"y\", linestyle=\"--\", alpha=0.2, color=\"white\")\n","        for spine in ax.spines.values():\n","            spine.set_color(\"#475569\")\n","        legend = ax.legend(\n","            facecolor=\"#1F2937\",\n","            edgecolor=\"#475569\",\n","            fontsize=10\n","        )\n","        for text_item in legend.get_texts():\n","            text_item.set_color(\"white\")\n","        plt.tight_layout()\n","        # Save as a standalone PNG image\n","        fig.savefig(\n","            IMAGE_PATH,\n","            dpi=180,\n","            bbox_inches=\"tight\",\n","            facecolor=fig.get_facecolor(),\n","            format=\"png\"\n","        )\n","        plt.close(fig)\n","        # Display the saved image directly\n","        display(Image(filename=IMAGE_PATH))\n","        print(f\"Valid scores: {len(scores):,}\")\n","        print(f\"Mean score: {mean_score:.3f}\")\n","        print(f\"Median score: {median_score:.3f}\")\n","        print(\"Static chart saved succ