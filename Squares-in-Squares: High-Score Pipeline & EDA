are centers\n","np.random.seed(42)\n","sample_n = 64\n","sim_x = np.random.uniform(0, 10, sample_n)\n","sim_y = np.random.uniform(0, 10, sample_n)\n","\n","sim_df = pd.DataFrame({\n","    \"x\": sim_x,\n","    \"y\": sim_y,\n","    \"index\": range(sample_n)\n","})\n","\n","# Create static visualization\n","fig, ax = plt.subplots(figsize=(12, 7), dpi=150)\n","fig.patch.set_facecolor(\"#111827\")\n","ax.set_facecolor(\"#111827\")\n","\n","# Plot square markers with a multicolor palette\n","points = ax.scatter(\n","    sim_df[\"x\"],\n","    sim_df[\"y\"],\n","    c=sim_df[\"index\"],\n","    cmap=\"Blues\",\n","    s=150,\n","    marker=\"s\",\n","    alpha=0.95,\n","    edgecolors=\"#F9FAFB\",\n","    linewidths=0.7\n",")\n","# Add colorbar\n","colorbar = fig.colorbar(points, ax=ax, pad=0.02)\n","colorbar.set_label(\"Square Index\", color=\"white\", fontsize=11)\n","colorbar.ax.tick_params(colors=\"white\")\n","colorbar.outline.set_edgecolor(\"#475569\")\n","# Title and axis labels\n","ax.set_title(\n","    f\"Simulated Square Packing Centers Preview (n={sample_n})\",\n","    fontsize=15,\n","    fontweight=\"bold\",\n","    color=\"white\",\n","    pad=18\n",")\n","ax.set_xlabel(\"X Coordinate\", fontsize=12, color=\"white\")\n","ax.set_ylabel(\"Y Coordinate\", fontsize=12, color=\"white\")\n","\n","# Coordinate limits and equal aspect ratio\n","ax.set_xlim(0, 10)\n","ax.set_ylim(0, 10)\n","ax.set_aspect(\"equal\", adjustable=\"box\")\n","\n","# Dark theme styling\n","ax.tick_params(colors=\"white\")\n","\n","for spine in ax.spines.values():\n","    spine.set_color(\"#475569\")\n","ax.grid(\n","    True,\n","    linestyle=\"--\",\n","    alpha=0.25,\n","    color=\"white\"\n",")\n","plt.tight_layout()\n","# Save high-resolution PNG\n","fig.savefig(\n","    IMAGE_PATH,\n","    dpi=180,\n","    bbox_inches=\"tight\",\n","    facecolor=fig.get_facecolor(),\n","    format=\"png\"\n",")\n","plt.close(fig)\n","# Display the saved image directly\n","display(Image(filename