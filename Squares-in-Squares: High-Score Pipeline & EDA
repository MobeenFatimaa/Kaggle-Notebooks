# Title\n","            ax.set_title(\n","                \"Metadata Feature Correlation Matrix Heatmap\",\n","                fontsize=15,\n","                fontweight=\"bold\",\n","                color=\"white\",\n","                pad=20\n","            )\n","            ax.tick_params(axis=\"both\", length=0)\n","            # Improve layout\n","            plt.tight_layout()\n","            # Save as a static PNG\n","            fig.savefig(\n","                IMAGE_PATH,\n","                dpi=180,\n","                bbox_inches=\"tight\",\n","                facecolor=fig.get_facecolor(),\n","                format=\"png\"\n","            )\n","            plt.close(fig)\n","            # Display saved image directly in notebook\n","            display(Image(filename=IMAGE_PATH))\n","            print(f\"Numeric features analyzed: {len(corr.columns)}\")\n","            print(f\"Heatmap saved to: {IMAGE_PATH}\")\n","            # Show strongest feature relationships\n","            corr_pairs = corr.where(\n","                np.triu(\n","                    np.ones(corr.shape, dtype=bool),\n","                    k=1\n","                )\n","            ).stack().reset_index()\n","            if not corr_pairs.empty:\n","                corr_pairs.columns = [\n","                    \"Feature 1\",\n","                    \"Feature 2\",\n","                    \"Correlation\"\n","                ]\n","                corr_pairs[\"Absolute Correlation\"] = (\n","                    corr_pairs[\"Correlation\"].abs()\n","                )\n","                print(\"\\nTop 10 strongest feature relationships:\")\n","                display(\n","                    corr_pairs.sort_values(\n","                        \"Absolute Correlation\",\n","                        ascending=False\n","                    )\n","                    .head(10)\n","                    .drop(columns=\"Absolute Correlation\")\n","                    .style.format({\"Correlatio