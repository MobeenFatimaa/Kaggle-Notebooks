(QZ[\"test_\" + n]) for n in QN] + [W_TE])\n","_XO = np.column_stack([L(QZ[\"oof_\" + n]) for n in QN] + [W])\n","_b = np.linalg.lstsq(_one(_XT), AT, rcond=None)[0]\n","REPLAY_R2 = 1 - ((AT - _one(_XT) @ _b) ** 2).mean() / AT.var()\n","A_OOF = _one(_XO) @ _b\n","del _XT, _XO\n","REF_OOF = A_OOF + 0.06 * (L(QZ[\"oof_lm7_5fold\"]) - L(QZ[\"oof_megayak_5f_lm\"]))\n","U0 = (rankdata(AT + 0.06 * (LM7_TE - LM_TE)) - 0.5) / NT\n","REF_TE = logit(U0)\n","log(f\"0.95370 file replayed on OOF: R2 {REPLAY_R2:.4f}, OOF AUC {roc_auc_score(y, REF_OOF):.6f} (wide LM stack {roc_auc_score(y, W):.6f})\")"]},{"cell_type":"code","execution_count":9,"id":"aa1fd050","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:24:17.265526Z","iopub.status.busy":"2026-11-14T10:24:17.265212Z","iopub.status.idle":"2026-11-14T10:24:47.053863Z","shell.execute_reply":"2026-11-14T10:24:47.052628Z"},"papermill":{"duration":29.801507,"end_time":"2026-11-14T10:24:47.055972+00:00","exception":false,"start_time":"2026-11-14T10:24:17.254465+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["rebuilt 0.95388 file identical to the published one (SHA-256): True\n","  careful                                  public  +6  in-sample CV vs 0.95370 replay +28.4  folds up 5/5\n","  balanced                                 public +10  in-sample CV vs 0.95370 replay +19.0  folds up 5/5\n","  bold                                     public +16  in-sample CV vs 0.95370 replay +32.8  folds up 5/5\n","  1.25 x bold                              public +17  in-sample CV vs 0.95370 replay +35.6  folds up 5/5\n","  1.5 x bold                               public +17  in-sample CV vs 0.95370 replay +36.1  folds up 5/5\n","  bold + 0.5 (bold - careful)              public +17  in-sample CV vs 0.95370 replay +32.1  folds up 5/5\n","  bold + 0.5 (bold - balanced)             public +18  in-sample CV vs 0.95370 replay +37.1  folds up 5/5\n","  bold + 1.0 (bold - balanced)       