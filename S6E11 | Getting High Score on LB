 in RECIPES[\"bold\"]}\n","QM_T = {k: qmember(k, \"test\") for k in RECIPES[\"bold\"]}\n","def mix(wts, part):\n","    \"\"\"(1 - sum w) base + sum_k w_k member_k, summed in the authors' order (so the test file is reproduced bit for bit).\"\"\"\n","    M, base = (QM_O, REF_OOF) if part == \"oof\" else (QM_T, REF_TE)\n","    return (1 - sum(wts.values())) * base + sum(w * M[k] for k, w in wts.items())\n","MO = {r: mix(RECIPES[r], \"oof\") for r in (\"careful\", \"balanced\", \"bold\")}\n","MT = {r: mix(RECIPES[r], \"test\") for r in (\"careful\", \"balanced\", \"bold\")}\n","MO[\"388\"], MT[\"388\"] = mix(W388, \"oof\"), mix(W388, \"test\")\n","S388 = (rankdata(MT[\"388\"]) - 0.5) / NT\n","BEST_SHA = \"b097969454128762dcd4929116d08fc9f00b3a6ebfe65fcbf7979ffaea3d729b\"\n","_chk = WORK / \"rebuild_095388.csv\"; sample[[\"id\"]].assign(is_fraud=S388).to_csv(_chk, index=False)\n","REBUILD_OK = sha256(_chk) == BEST_SHA\n","print(\"rebuilt 0.95388 file identical to the published one (SHA-256):\", REBUILD_OK)\n","if not REBUILD_OK:\n","    print(\"  NOTE: floating-point differences between numpy builds can swap a few tied ranks; the file is the same recipe.\")\n","\n","# Every probe of the two ladders is a linear combination of these mixes (the weights are linear), on OOF and on test alike.\n","def combo(parts, side):\n","    D, base = (MO, REF_OOF) if side == \"oof\" else (MT, REF_TE)\n","    return sum(c * (base if k == \"ref\" else D[k]) for k, c in parts.items())\n","PROBES = {   # name: (combination, public LB, author)\n","    \"careful\": ({\"careful\": 1}, 95376, \"goodpjw2008\"), \"balanced\": ({\"balanced\": 1}, 95380, \"goodpjw2008\"),\n","    \"bold\": ({\"bold\": 1}, 95386, \"goodpjw2008\"),\n","    \"1.25 x bold\": ({\"bold\": 1.25, \"ref\": -0.25}, 95387, \"Areeb Ali\"), \"1.5 x bold\": ({\"bold\": 1.5, \"ref\": -0.5}, 95387, \"Areeb Ali\"),\n","    \"bold + 0.5 (bold - careful)\": ({\"bold\": 1.5, \"careful\": -0.5}, 95387, \"Areeb Ali\"),\n","    \"bold + 0.5 (bold - balanced)\": ({\"bold\": 1.5, \"balanced\": -0.5}, 95388, \"Areeb Ali\"),\n","    \"bold + 1.0 (bold - balanced)\": ({\"bold\": 2.0, \"balanced\": -1.0}, 95387, \"Areeb Ali\"),\n","    \"bold + 1.5 (bold - balanced)\": ({\"bold\": 2.5, \"balanced\": -1.5}, 95387, \"Areeb Ali\"),\n","    \"bold + 2.0 (bold - balanced)\": ({\"bold\": 3.0, \"balanced\": -2.0}, 95385, \"Areeb Ali\"),\n","    \"1.25 x (bold + 1.0 (bold - balanced))\": ({\"bold\": 2.5, \"balanced\": -1.25, \"ref\": -0.25}, 95386, \"Areeb Ali\"),\n","}\n","PO = {n: combo(c, \"oof\") for n, (c, _, _) in PROBES.items()}\n","assert np.abs(PO[\"bold + 0.5 (bold - balanced)\"] - MO[\"388\"]).max() < 1e-4   # same file up to float rounding\n","PO[\"bold + 0.5 (bold - balanced)\"] = MO[\"388\"]\n","PO[\"10% wide LM stack\"] = 0.9 * A_OOF + 0.1 * W; PO[\"25% wide LM stack\"] = 0.75 * A_OOF + 0.25 * W   # goodpjw2008 v3 probes: 95368, 95362\n","PO[\"388 + 5% GP + DVAE\"] = 0.95 * L(MO[\"388\"]) + 0.05 * L(QZ[\"oof_daoviet_gpdvae\"])                   # probes on the 0.95388 file reported\n","PO[\"388 + 5% shallow tree\"] = 0.95 * L(MO[\"388\"]) + 0.05 * L(QZ[\"oof_megayak_shallow_tree\"])         # by Sameer Shaikh (Part 3): 95385, 95387\n","\n","def fold_aucs(s): return np.array([auc_sort(y[b], s[b]) for b in FOLDS])\n","FA = {\"ref\": fold_aucs(REF_OOF), \"W\": fold_aucs(W)}\n","for n, s in PO.items(): FA[n] = fold_aucs(s)\n","OOFAUC = {\"ref\": roc_auc_score(y, REF_OOF), \"W\": roc_auc_score(y, W)}\n","for n, s in PO.items(): OOFAUC[n] = roc_auc_score(y, s)\n","def chg(a, b):\n","    \"\"\"CV change of a over b: overall OOF AUC change (x 1e-5, as the authors report it) and the five per-fold changes.\"\"\"\n","    return (OOFAUC[a] - OOFAUC[b]) * 1e5, (FA[a] - FA[b]) * 1e5\n","for n in PROBES: print(f\"  {n:40s} public {PROBES[n][1] - 95370:+3d}  in-sample CV vs 0.95370 replay {chg(n, 'ref')[0]:+5.1f}  folds up {(chg(n, 'ref')[1] > 0).sum()}/5\")\n","# independent check: the same change from the per-fold AUCs (a different estimator; should be close)\n","print(f\"check: bold vs replay, mean of fold changes {chg('bold', 'ref')[1].mean():+.1f}e-5; authors report +28.4 / +19.0 / +32.8 / +37.1 in-sample\")"]},{"cell_type":"code","execution_count":10,"id":"f6d93789","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:24:47.074229Z","iopub.status.busy":"2026-11-14T10:24:47.073641Z","iopub.status.idle":"2026-11-14T10:26:19.757922Z","shell.execute_reply":"2026-11-14T10:26:19.756343Z"},"papermill":{"duration":92.695967,"end_time":"2026-11-14T10:26:19.76002+00:00","exception":false,"start_time":"2026-11-14T10:24:47.064053+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["  goodpjw2008: best of 5 on public: public +35.9, private +30.0, give-back +5.9e-5\n","  Areeb Ali: best of 8 on public: public +11.3, private +6.1, give-back +5.2e-5\n","  rule check careful                                1-rho 6.48e-04: measured public SD 12.1, rule 11.9\n","  rule check balanced                               1-rho 5.61e-04: measured public SD 11.3, rule 11.1\n","  rule check bold                                   1-rho 1.53e-03: measured public SD 19.0, rule 18.3\n","  rule check bold + 0.5 (bold - balanced) vs bold   1-rho 7.21e-05: measured public SD  4.2, rule  4.0\n","  rule check bold + 1.5 (bold - balanced) vs bold   1-rho 6.47e-04: measured public SD 12.6, rule 11.9\n","  rule check 1.5 x bold vs bold                     1-rho 3.80e-04: measured public SD  9.4, rule  9.1\n"]}],"source":["# Public noise of every step (the one-line rule on the TEST files) and the private give-back of public selection,\n","# simulated on the OOF rows with the real public/private sizes: on each random split the probe with the best public gap\n","# is kept, as the authors did, and its private gap is read.\n","TE = {\"0.95354 file\": L(out) if HAVE_LADDER else None, \"0.95370 file\": REF_TE}\n","for n, (c, _, _) in PROBES.items(): TE[n] = combo(c, \"test\")\n","def rho_te(a, b): return np.corrcoef(rankdata(TE[a]), rankdata(TE[b]))[0, 1]\n","def sig(r): return K_RULE * np.sqrt(max(1 - r, 0)) * 1e5\n","\n","FAMILIES = {   # the probes each author compared on the board before keeping one, and the base they compared against\n","    \"goodpjw2008\": (\"ref\", [\"careful\", \"balanced\", \"bold\", \"10% wide LM stack\", \"25% wide LM stack\"]),\n","    \"Areeb Ali\": (\"bold\", [\"1.25 x bold\", \"1.5 x bold\", \"bold + 0.5 (bold - careful)\", \"bold + 0.5 (bold - balanced)\",\n","                           \"bold + 1.0 (bold - balanced)\", \"bold + 1.5 (bold - balanced)\", \"bold + 2.0 (bold - balanced)\",\n","                           \"1.25 x (bold + 1.0 (bold - balanced))\"]),\n","}\n","_sc = {\"ref\": REF_OOF, **PO}\n","_names = [\"ref\"] + [n for n in PO]\n","_preps = [auc_prep(_sc[n]) for n in _names]\n","QAUC = np.zeros((len(_names), R, 2))\n","rng = np.random.default_rng(2611)\n","for r_ in range(R):\n","    cp = np.bincount(rng.integers(0, N, NPUB), minlength=N).astype(np.int32)\n","    cq = np.bincount(rng.integers(0, N, NT - NPUB), minlength=N).astype(np.int32)\n","    dp = float(cp[y].sum()) * float(cp[~y].sum()); dq = float(cq[y].sum()) * float(cq[~y].sum())\n","    for i, pr in enumerate(_preps): QAUC[i, r_, 0] = auc_counts(pr, cp, dp); QAUC[i, r_, 1] = auc_counts(pr, cq, dq)\n","del _preps\n","QI = {n: i for i, n in enumerate(_names)}\n","def qgap(a, b): return (QAUC[QI[a]] - QAUC[QI[b]]) * 1e5        # (draw, public/private)\n","GIVE = {}\n","for fam, (base, probes) in FAMILIES.items():\n","    G = np.stack([qgap(p, base) for p in probes])                 # (probe, draw, 2)\n","    j = G[:, :, 0].argmax(0)\n","    pick_pub, pick_prv = G[j, np.arange(R), 0], G[j, np.arange(R), 1]\n","    GIVE[fam] = dict(pub=pick_pub, prv=pick_prv, back=pick_pub - pick_prv, sd_pub=G[:, :, 0].std(1), K=len(probes))\n","    print(f\"  {fam}: best of {len(probes)} on public: public {pick_pub.mean():+.1f}, private {