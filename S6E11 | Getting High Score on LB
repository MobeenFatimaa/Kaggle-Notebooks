w_pickle=False).astype(np.float64))\n","EXT_NAMES = list(EXT_O)\n","WGRID = np.array([-0.05, -0.03, -0.02, -0.01, 0.01, 0.02, 0.03, 0.05])\n","print(f\"{len(EXT_NAMES)} candidate members x {len(WGRID)} weights = {len(EXT_NAMES) * len(WGRID)} candidate steps\")\n","\n","def ext_round(B):\n","    \"\"\"Per-fold AUC gain (x 1e-5) of every candidate step on base B, then the nested choice and the gate.\"\"\"\n","    base_f = np.array([auc_sort(y[b], B[b]) for b in FOLDS])\n","    G = np.zeros((len(EXT_NAMES), len(WGRID), 5))\n","    for i, n_ in enumerate(EXT_NAMES):\n","        D = EXT_O[n_] - B\n","        for j, w in enumerate(WGRID):\n","            s = B + w * D\n","            G[i, j] = (np.array([auc_sort(y[b], s[b]) for b in FOLDS]) - base_f) * 1e5\n","    outer, picks = np.zeros(5), []\n","    for f in range(5):\n","        inner = [g for g in range(5) if g != f]\n","        i, j = np.unravel_index(G[:, :, inner].mean(2).argmax(), G.shape[:2])\n","        outer[f] = G[i, j, f]; picks.append((EXT_NAMES[i], WGRID[j]))\n","    i, j = np.unravel_index(G.mean(2).argmax(), G.shape[:2])\n","    passed = (outer > 0).sum() >= 4 and outer.mean() > 0\n","    return dict(G=G, outer=outer, picks=picks, final=(EXT_NAMES[i], WGRID[j]), final_in=G[i, j].mean(), passed=passed)\n","\n","B_O, B_T = L(MO[\"388\"]), logit(S388)\n","EXT, cur_O, cur_T = [], B_O, B_T\n","for step in (1, 2):\n","    rd = ext_round(cur_O); EXT.append(rd)\n","    print(f\"step {step}: outer-fold gains {np.round(rd['outer'], 1)} (positive on {(rd['outer'] > 0).sum()}/5, mean {rd['outer'].mean():+.1f}); \"\n","          f\"inner picks {[f'{a} {b:+.2f}' for a, b in rd['picks']]}\")\n","    print(f\"        best step on all five folds (in-sample): {rd['final'][0]} {rd['final'][1]:+.2f}, {rd['final_in']:+.1f}e-5 -> gate {'PASSED' if rd['passed'] else 'NOT passed'}\")\n","    if not rd[\"passed\"]: break\n","    n_, w = rd[\"final\"]\n","    cur_O = cur_O + w * (EXT_O[n_] - cur_O); cur_T = cur_T + w * (EXT_T[n_] - cur_T)\n","N_STEPS = sum(r[\"passed\"] for r in EXT)\n","SUB = S388 if N_STEPS == 0 else (rankdata(cur_T) - 0.5) / NT\n","sample[[\"id\"]].assign(is_fraud=SUB).to_csv(WORK / \"submission.csv\", index=False)\n","SUB_SHA = sha256(WORK / \"submission.csv\")\n","print(f\"submission.csv: {N_STEPS} extension step(s); SHA-256 {SUB_SHA}; identical to the rebuilt 0.95388 file: {SUB_SHA == sha256(_chk)}\")\n","if N_STEPS:\n","    print(f\"  rank correlation with the 0.95388 file {np.corrcoef(rankdata(SUB), rankdata(S388))[0, 1]:.6f}; \"\n","          f\"public-gap noise of the change ~{sig(np.corrcoef(rankdata(SUB), rankdata(S388))[0, 1]):.1f}e-5\")\n","del EXT_T"]},{"cell_type":"code","execution_count":13,"id":"94180531","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:27:00.226526Z","iopub.status.busy":"2026-11-14T10:27:00.225949Z","iopub.status.idle":"2026-11-14T10:27:22.245517Z","shell.execute_reply":"2026-11-14T10:27:22.244584Z"},"papermill":{"duration":22.031286,"end_time":"2026-11-14T10:27:22.24742+00:00","exception":false,"start_time":"2026-11-14T10:27:00.216134+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["  wide LM stack    OOF AUC 0.952565\n","  0.95370 replay   OOF AUC 0.952084\n","  bold mix         OOF AUC 0.952412\n","  0.95388 file     OOF AUC 0.952455\n","  0.95370 replay -> bold mix: full change +32.8e-5; the 1% most-moved rows alone +3.4, 5% +8.0; fraud rate in that 1% 0.1%\n","  bold mix -> 0.95388 file: full change +4.3e-5; the 1% most-moved rows alone +0.5, 5% +1.0; fraud rate in that 1% 0.1%\n","  wide LM stack -> 0.95388 file: full change -11.0e-5; the 1% most-moved rows alone -3.0, 5% -5.8; fraud rate in that 1% 0.1%\n","[ 7.6 min] error analysis done\n"]}],"source":["# ERROR ANALYSIS on the OOF rows (the stand-in test set): the honest wide LM stack W, the 0.95370 replay REF, the bold mix\n","# and the 0.95388 file's OOF counterpart. Every change below is computed by applying a step to a SUBSET of rows only.\n","EA = {\"wide LM stack\": W, \"0.95370 replay\": REF_OOF, \"bold mix\": L(PO[\"bold\"]), \"0.95388 file\": B_O}\n","EA = {k: L(v) for k, v in EA.items()}\n","EA_AUC = {k: roc_auc_score(y, v) for k, v in EA.items()}\n","for k, v in EA_AUC.items(): print(f\"  {k:16s} OOF AUC {v:.6f}\")\n","UR = {k: (rankdata(v) - 0.5) / N for k, v in EA.items()}\n","STEPS_EA = [(\"0.95370 replay\", \"bold mix\"), (\"bold mix\", \"0.95388 file\"), (\"wide LM stack\", \"0.95388 file\")]\n","def masked_gain(a, b, m):\n","    \"\"\"AUC change (x1e-5) when file a takes file b's logit ranks on the rows in mask m only.\"\"\"\n","    s = EA[a].copy(); s[m] = EA[b][m]; return (auc_sort(y, s) - auc_sort(y, EA[a])) * 1e5\n","# (a) where the files disagree: the most-moved rows first\n","QGRID = [0.005, 0.01, 0.02, 0.05, 0.10, 0.20, 0.50, 1.0]\n","DISAG = {}\n","for a, b in STEPS_EA:\n","    mv = np.abs(UR[b] - UR[a]); order_ = np.argsort(-mv)\n","    gains = []\n","    for q in QGRID:\n","        m = np.zeros(N, bool); m[order_[:int(round(q * N))]] = True; gains.append(masked_gain(a, b, m))\n","    DISAG[(a, b)] = dict(gain=np.array(gains), fraud_top1=y[order_[:N // 100]].mean(), mv=mv)\n","    print(f\"  {a} -> {b}: full change {gains[-1]:+.1f}e-5; the 1% most-moved rows alone {gains[1]:+.1f}, 5% {gains[3]:+.1f}; fraud rate in that 1% {y[order_[:N // 100]].mean():.1%}\")\n","# (b) segments: score band of the base file, how common the transaction amount is (value count over train + test), channel\n","_amt_te = pd.read_csv(find(\"test.csv\", inside=COMP), usecols=[\"amount_usd\"])[\"amount_usd\"]\n","_vc = pd.concat([train[\"amount_usd\"], _amt_te]).value_counts()\n","AMT_CNT = train[\"amount_usd\"].map(_vc).to_numpy()\n","SEGS = {\n","    \"score band (rank in the base file)\": lambda base: [(\"bottom 80%\", UR[base] < 0.80), (\"80-95%\", (UR[base] >= 0.80) & (UR[base] < 0.95)),\n","                                                        (\"95-99%\", (UR[base] >= 0.95) & (UR[base] < 0.99)), (\"top 1%\", UR[base] >= 0.99)],\n","    \"how common the amount is\": lambda base: [(\"unique\", AMT_CNT == 1), (\"2-3 rows\", (AMT_CNT >= 2) & (AMT_CNT <= 3)),\n","                                              (\"4-20 rows\", (AMT_CNT >= 4) & (AMT_CNT <= 20)), (\"> 20 rows\", AMT_CNT > 20)],\n","    \"channel\": lambda base: [(str(c), (train[\"channel\"] == c).to_numpy()) for c in sorted(train[\"channel\"].unique())],\n","}\n","SEG_TAB = []\n","for a, b in STEPS_EA:\n","    for sname, fn in SEGS.items():\n","        for lab, m in fn(a):\n","            SEG_TAB.append(dict(step=f\"{a} -> {b}\", segmentation=sname, segment=lab, rows=m.mean(), frauds=y[m].sum() / y.sum(),\n","                                gain=masked_gain(a, b, m), moved=np.abs(UR[b] - UR[a])[m].mean() * 1e3,\n","                                lift=((UR[b] - UR[a])[m & y].mean() - (UR[b] - UR[a])[m & ~y].mean()) * 1e3))\n","    for lab, m in [(\"frauds only\", y), (\"legit rows only\", ~y), (\"frauds ranked below 80%\", y & (UR[a] < 0.80))]:\n","        SEG_TAB.append(dict(step=f\"{a} -> {b}\", segmentation=\"by label (analysis only)\", segment=lab, rows=m.mean(), frauds=y[m].sum() / y.sum(),\n","                            gain=masked_gain(a, b, m), moved=np.abs(UR[b] - UR[a])[m].mean() * 1e3, lift=np.nan))\n","SEG_TAB = pd.DataFrame(SEG_TAB)\n","# (c) rank shift of frauds and legit rows along the base file's score (calibration of the order)\n","EDGES = np.r_[0, 0.5, 0.8, 0.9, 0.95, 0.97, 0.98, 0.99, 0.995, 0.998, 1.0]\n","SHIFT = {}\n","for a, b in STEPS_EA:\n","    d = UR[b] - UR[a]; band = np.clip(np.searchsorted(EDGES, UR[a], side=\"right\") - 1, 0, len(EDGES) - 2)\n","    SHIFT[(a, b)] = np.array([[d[(band == i) & y].mean() * 1e3, d[(band == i) & ~y].mean() * 1e3, (band == i).sum(), (y & (band == i)).sum()]\n","                              for i in range(len(EDGES) - 1)])\n","CAPTURE = {k: [y[UR[k] >= 1 - q].sum() / y.sum() for q in (0.01, 0.02, 0.05)] for k in EA}\n","log(\"error analysis done\")"]},{"cell_type":"markdown","id":"3e7c2d27","metadata":{"papermill":{"duration":0.008101,"end_time":"2026-11-14T10:27:22.26377+00:00","exception":false,"start_time":"2026-11-14T10:27:22.255669+00:00","status":"completed"},"tags":[]},"source":["<a id=\"hero\"></a>\n","<div style=\"background: #0b1f4b; color: #ffffff; padding: 9px 16px; border-radius: 8px; font-size: 20px; font-weight: 700;\">The whole story in one figure</div>"]},{"cell_type":"code","execution_count":14,"id":"75d739fc","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:27:22.282596Z","iopub.status.busy":"2026-11-14T10:27:22.282293Z","iopub.status.idle":"2026-11-14T10:27:23.670432Z","shell.execute_reply":"2026-11-14T10:27:23.669366Z"},"papermill":{"duration":1.405688,"end_time":"2026-11-14T10:27:23.677589+00:00","exception":false,"start_time":"2026-11-14T10:27:22.271901+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1760x1364 with 8 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Hero figure: KPI tiles + four panels (rungs vs noise, public vs nested CV, winner's curse, the top band).\n","PUB_FRAUD = NPUB * y.mean()\n","MV = {m[0]: m for m in MOVES}\n","VARIANT = {\"GPT-2 seed swap 0.10\"}                               # the same rung at another weight: counted once\n","POS = [m[0] for m in MOVES if m[2] > 0 and m[0] not in VARIANT]  # distinct probes the public board rewarded\n","CONF = [n for n in POS if TRUE[n] > 0 and UP[n] >= 4]            # ... that nested CV also confirms (>= 4 of 5 folds)\n","SHORT = {\"+0.12 megayak LM\": \"+ megayak LM\", \"+0.06 seed-7 LM\": \"+ seed-7 LM\", \"+0.12 public GPT-2\": \"+ public GPT-2\",\n","         \"+0.05 GP + DVAE\": \"+ GP + DVAE\", \"LM weight 0.12 -> 0.09\": \"LM 0.12 -> 0.09\", \"more of both LMs\": \"more of both LMs\",\n","         \"less seed-7 LM\": \"less seed-7 LM\", \"GPT-2 seed swap 0.06\": \"GPT-2 seed swap\", \"GPT-2 seed swap 0.10\": \"seed swap at 0.10\"}\n","\n","def hero_rungs(ax):\n","    steps = STEPS if HAVE_LADDER else [(n, MV[n][2], ONE_RHO[NAMES.index(n)], SD_PUB[NAMES.index(n)]) for n in POS]\n","    yy = np.arange(len(steps))[::-1]\n","    for yi, (lab, g, _, sd) in zip(yy, steps):\n","        ax.add_patch(FancyBboxPatch((-2 * sd, yi - 0.34), 4 * sd, 0.68, boxstyle=\"round,pad=0,rounding_size=0.12\", facecolor=BAND, edgecolor=\"none\", zorder=1))\n","        ax.add_patch(FancyBboxPatch((-sd, yi - 0.34), 2 * sd, 0.68, boxstyle=\"round,pad=0,rounding_size=0.12\", facecolor=\"#d6d5d0\", edgecolor=\"none\", zorder=1))\n","        ax.barh(yi, g, height=0.36, color=PUB, zorder=3)\n","        ax.annotate(f\"+{g}\", (max(g, 2 * sd), yi), xytext=(6, 0), textcoords=\"offset points\", va=\"center\", fontsize=10, fontweight=\"bold\", color=INK)\n","        ax.annotate(f\"noise SD {sd:.1f}\", (max(g, 2 * sd), yi), xytext=(30, 0), textcoords=\"offset points\", va=\"center\", fontsize=8.5, color=INK2)\n","    ax.set_yticks(yy); ax.set_yticklabels([s[0] for s in steps], fontsize=9); ax.tick_params(axis=\"y\", length=0)\n","    lim = max(max(s[1] for s in steps), 2 * max(s[3] for s in steps))\n","    ax.set_xlim(-lim * 1.05, lim * 2.0); ax.set_ylim(-0.6, len(steps) - 0.4)\n","    ax.xaxis.set_major_formatter(E5); ax.grid(axis=\"y\", visible=False)\n","    ax.set_xlabel(\"public LB change of the step (x 1e-5)\")\n","    zero_line(ax, \"x\")\n","    ax.legend(handles=[Patch(color=PUB, label=\"reported public gain\"), Patch(color=\"#d6d5d0\", label=\"1 SD of public noise\"),\n","                       Patch(color=BAND, label=\"2 SD\")], loc=\"upper center\", bbox_to_anchor=(0.5, -0.17), ncol=3, fontsize=8.5)\n","\n","def hero_scatter(ax):\n","    moves = [m[0] for m in MOVES]\n","    for n in moves:\n","        i = NAMES.index(n); x, yv = TRUE[n], MV[n][2]; good = n in CONF or (n in VARIANT and TRUE[n] > 0 and UP[n] >= 4)\n","        ax.plot([x, x], [yv - SD_PUB[i], yv + SD_PUB[i]], color=RULE, lw=2.2, solid_capstyle=\"round\", zorder=2)\n","        ax.scatter(x, yv, s=110 if good else 60, color=CV if good else PUB, edgecolor=SURF, lw=1.5, zorder=4)\n","    ax.set_xlim(-9.5, 4); ax.set_ylim(-16.5, 6)\n","    ax.plot([-9.5, 4], [-9.5, 4], color=MUTED, lw=1, ls=(0, (4, 3)), zorder=1)\n","    ax.text(-9.3, -10.0, \"dashed: public = CV\", color=MUTED, fontsize=8.5, va=\"top\")\n","    zero_line(ax, \"x\"); zero_line(ax, \"y\")\n","    ax.annotate(\"+ public GPT-2: -14 public,\\nand down on 5 of 5 folds\", (TRUE[\"+0.12 public GPT-2\"], -14), xytext=(14, 0), textcoords=\"offset points\",\n","                fontsize=8.5, color=INK2, va=\"center\")\n","    ax.annotate(\"+ megayak LM\", (TRUE[\"+0.12 megayak LM\"], MV[\"+0.12 megayak LM\"][2]), xytext=(-8, 9), textcoords=\"offset points\",\n","                fontsize=8.5, color=INK2, ha=\"right\")\n","    ax.annotate(\"GPT-2 seed swap:\\nup on both boards\", (TRUE[\"GPT-2 seed swap 0.06\"], 2), xytext=(4, 34), textcoords=\"offset points\",\n","                fontsize=9, color=CVTXT, fontweight=\"bold\", ha=\"center\", arrowprops=dict(arrowstyle=\"-\", color=CVTXT, lw=1))\n","    cl = [n for n in moves if n not in (\"+0.12 public GPT-2\", \"+0.12 megayak LM\", \"GPT-2 seed swap 0.06\", \"GPT-2 seed swap 0.10\")]\n","    x0, x1 = min(TRUE[n] for n in cl) - 0.35, max(TRUE[n] for n in cl) + 0.35\n","    y0, y1 = min(MV[n][2] for n in cl) - 0.8, max(MV[n][2] for n in cl) + 0.8\n","    ax.add_patch(FancyBboxPatch((x0, y0), x1 - x0, y1 - y0, boxstyle=\"round,pad=0,rounding_size=0.4\", facecolor=\"none\",\n","                                edgecolor=PUB, lw=1, ls=(0, (2, 2)), zorder=3))\n","    ax.annotate(f\"{len(cl)} more probes: public {min(MV[n][2] for n in cl):+d} to {max(MV[n][2] for n in cl):+d},\\n\"\n","                f\"nested CV {min(TRUE[n] for n in cl):+.1f} to {max(TRUE[n] for n in cl):+.1f}\", (x0, y0 + 0.2), xytext=(-10, -26),\n","                textcoords=\"offset points\", fontsize=8.5, color=INK2, ha=\"right\", va=\"top\", arrowprops=dict(arrowstyle=\"-\", color=PUB, lw=0.8))\n","    ax.xaxis.set_major_formatter(E5); ax.yaxis.set_major_formatter(E5)\n","    ax.set_xlabel(\"change in nested CV on the public OOF (x 1e-5)\"); ax.set_ylabel(\"reported public LB change (x 1e-5)\")\n","    ax.text(0.99, 0.02, \"grey bars: 1 SD of public noise\", transform=ax.transAxes, ha=\"right\", va=\"bottom\", fontsize=8, color=MUTED)\n","\n","def hero_curse(ax):\n","    ax.plot(KS, SIG_RUNG * EMAX, color=PUB, lw=2, label=\"best public gain of K null probes (theory)\")\n","    ax.fill_between(KS, 0, SIG_RUNG * EMAX, color=PUB, alpha=0.07, lw=0)\n","    kk = np.array(KGRID)\n","    ax.plot(kk, [CURSE[k][:, 0].mean() for k in KGRID], \"o\", color=PUB, ms=7, mec=SURF, mew=1.5, label=\"best of K real probes: public part\")\n","    ax.plot(kk, [CURSE[k][:, 1].mean() for k in KGRID], \"o-\", color=PRIV, ms=7, mec=SURF, mew=1.5, lw=1.4, label=\"the same pick: private part\")\n","    zero_line(ax)\n","    ax.set_ylim(min(-4, min(CURSE[k][:, 1].mean() for k in KGRID) - 2), SIG_RUNG * EMAX[-1] * 1.12)\n","    med = int(np.median(LB14_SUBS[:50]))\n","    ax.axvline(med, color=MUTED, lw=1, ls=(0, (3, 3)))\n","    ax.text(med * 1.07, SIG_RUNG * EMAX[-1] * 0.45, f\"median top-50 team:\\n{med} submissions\", fontsize=8.5, color=INK2, va=\"top\")\n","    ax.set_xscale(\"log\"); ax.set_xticks([1, 2, 5, 10, 20, 50, 100]); ax.set_xticklabels([\"1\", \"2\", \"5\", \"10\", \"20\", \"50\", \"100\"])\n","    ax.yaxis.set_major_formatter(E5); ax.yaxis.set_major_locator(MaxNLocator(6, integer=True))\n","    ax.set_xlabel(\"number of probes K compared on the public board\")\n","    ax.set_ylabel(\"score change of the chosen probe (x 1e-5)\"); ax.legend(loc=\"upper left\", fontsize=8.5)\n","\n","def hero_board(ax):\n","    lo, hi, ref = 95330, 95450, 388                      # 14 Nov snapshot; #1 and #2 lie far to the right\n","    v14 = LB14_TOP[(LB14_TOP + 95000 >= lo) & (LB14_TOP + 95000 <= hi)]\n","    vals, cnt = np.unique(v14, return_counts=True)\n","    ax.axvspan(ref - 2 * SIG_RUNG, ref + 2 * SIG_RUNG, color=BAND, zorder=0, lw=0)\n","    ax.text(ref - 2 * SIG_RUNG - 0.8, cnt.max() * 1.22, f\"within 2 rung-noise SDs\\nof 0.95388: {N_2SIG14} teams\", fontsize=8.5, color=INK2, va=\"top\", ha=\"right\")\n","    ax.bar(vals, cnt, width=0.75, color=[PUB if c < 10 else NAVY for c in cnt], zorder=3)\n","    for v, c in zip(vals, cnt):\n","        if c >= 15: ax.text(v, c + 0.6, f\"0.95{v:03d}\\n{c} teams\", ha=\"center\", va=\"bottom\", fontsize=8, color=INK)\n","    ax.annotate(f\"#2 0.95{LB14_TOP[1]}, #1 0.95{LB14_TOP[0]}\\n(far off this scale)\", xy=(hi - 95000, cnt.max() * 0.25), xytext=(-8, 0),\n","                textcoords=\"offset points\", ha=\"right\", va=\"center\", fontsize=8.5, color=PRIV, fontweight=\"bold\",\n","                arrowprops=None)\n","    ax.annotate(\"\", xy=(hi - 95000 + 0.6, cnt.max() * 0.25), xytext=(hi - 95000 - 0.2, cnt.max() * 0.25),\n","                arrowprops=dict(arrowstyle=\"->\", color=PRIV, lw=1.4))\n","    ax.set_xlim(lo - 95000 - 1, hi - 95000 + 1); ax.set_ylim(0, cnt.max() * 1.3)\n","    ax.xaxis.set_major_formatter(FuncFormatter(lambda v, _: f\"0.95{int(v):03d}\")); ax.xaxis.set_major_locator(MaxNLocator(7, integer=True))\n","    ax.set_xlabel(\"public LB score (14 Nov)\"); ax.set_ylabel(\"teams with exactly this score\")\n","\n","N_2SIG14 = int((np.abs(LB14_TOP - 388) <= 2 * SIG_RUNG).sum())\n","SD388 = sig(rho_te(\"bold + 0.5 (bold - balanced)\", \"bold\"))\n","fig = plt.figure(figsize=(16, 12.4))\n","fig.text(0.02, 0.975, \"How much of the public top is real?\", fontsize=24, fontweight=\"bold\", color=INK, va=\"top\")\n","fig.text(0.02, 0.937, \"Ladder steps of one or two points sit inside the noise of the 60k-row public board, and nested CV confirms few of them. \"\n","         \"New in v4: the 0.95388 ladder, checked the same way.\", fontsize=12, color=INK2, va=\"top\")\n","tw, gap, ty = 0.2275, 0.0133, 0.815\n","TILES = [(\"Noise of one ladder rung\", f\"±{SIG_RUNG:.1f}e-5\", \"1 SD of the public gap between consecutive rungs\", NAVY),\n","         (\"Old-ladder gains confirmed by nested CV\", f\"{len(CONF)} of {len(POS)}\", \"public probes that also gain on >= 4 of 5 folds\", CV),\n","         (\"New: the step to 0.95388\", f\"+2 vs ±{SD388:.1f}\", \"public gain vs 1 SD of its noise; best of 8 probes\", PUB),\n","         (\"New: honest steps on top of 0.95388\", f\"{N_STEPS} of {len(EXT_NAMES) * len(WGRID)}\", \"candidate steps that pass the nested 4-of-5 gate\", PRIV)]\n","for i, t_ in enumerate(TILES): tile(fig, [0.02 + i * (tw + gap), ty, tw, 0.095], *t_)\n","axs = [fig.add_axes([0.205, 0.465, 0.29, 0.26]), fig.add_axes([0.605, 0.43, 0.37, 0.295]),\n","       fig.add_axes([0.06, 0.06, 0.40, 0.28]), fig.add_axes([0.56, 0.06, 0.41, 0.28])]\n","hero_rungs(axs[0]);   panel_title(axs[0], \"A  Each rung gains about one noise SD\", \"public gain of consecutive ladder files vs. the noise of that gap\")\n","hero_scatter(axs[1]); panel_title(axs[1], \"B  Public says up; nested CV mostly says flat or down\", \"every public probe with OOF files behind it, replayed on the wide-stack OOF\")\n","hero_curse(axs[2]);   panel_title(axs[2], \"C  The best of many probes gains on public, not on private\", \"random public/private draws from the OOF; probes = small steps towards public members\")\n","hero_board(axs[3]);   panel_title(axs[3], \"D  The top band is a few rung-noise SDs wide\", \"public leaderboard, 14 Nov; tall bars = many teams at exactly the score of a public notebook\")\n","plt.show()"]},{"cell_type":"markdown","id":"e0c158f3","metadata":{"papermill":{"duration":0.011883,"end_time":"2026-11-14T10:27:23.701497+00:00","exception":false,"start_time":"2026-11-14T10:27:23.689614+00:00","status":"completed"},"tags":[]},"source":["<div style=\"background: #eef4fc; border-left: 5px solid #2a78d6; padding: 10px 14px; border-radius: 6px; margin: 6px 0;\">\n","<b>In one paragraph.</b> A ladder rung of one or two points is about one noise SD of the public gap between the two\n","files (panel A). Replayed on a nested OOF, most rungs that won on public are flat or negative; the one that holds up,\n","a second seed of the same model, has an obvious mechanism (panel B). Choosing the best of many probes by public score\n","guarantees a public gain even when nothing is better, and the private part does not repeat it (panel C). The top of\n","the board is only a few such noise SDs wide, and many teams sit on the exact score of a public notebook (panel D).\n","</div>"]},{"cell_type":"markdown","id":"398812b0","metadata":{"papermill":{"duration":0.011377,"end_time":"2026-11-14T10:27:23.724382+00:00","exception":false,"start_time":"2026-11-14T10:27:23.713005+00:00","status":"completed"},"tags":[]},"source":["<a id=\"s1\"></a>\n","<div style=\"background: #0b1f4b; color: #ffffff; padding: 9px 16px; border-radius: 8px; font-size: 20px; font-weight: 700;\">1 &middot; The competition in five minutes</div>\n","\n","* **Data.** 699,960 synthetic card transactions to train on, 299,984 to predict; 24 columns (amount, timing, device,\n","  merchant, risk scores, flags). About **1.67%** of the training rows are fraud.\n","* **Metric.** ROC-AUC: the probability that a random fraud is ranked above a random legitimate transaction. Only the\n","  **order** of the predictions matters, which is why every public blend here works on logit ranks\n","  `L(v) = logit((rank(v) - 0.5) / n)`.\n","* **The split.** The public leaderboard scores **20%** of the test rows, the private leaderboard (the final ranking)\n","  the other **80%**. Both are fixed for everyone; nobody knows which rows are which.\n","* **Units.** Gaps at the top are a few hundred-thousandths of AUC. We write them as **points of 1e-5**:\n","  0.95354 - 0.95352 = +2 points."]},{"cell_type":"code","execution_count":15,"id":"244129d9","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:27:23.749106Z","iopub.status.busy":"2026-11-14T10:27:23.748599Z","iopub.status.idle":"2026-11-14T10:27:23.906287Z","shell.execute_reply":"2026-11-14T10:27:23.905349Z"},"papermill":{"duration":0.172629,"end_time":"2026-11-14T10:27:23.908562+00:00","exception":false,"start_time":"2026-11-14T10:27:23.735933+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1430x319 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# The two boards in rows and expected frauds (train fraud rate applied to the test set).\n","fig, ax = plt.subplots(figsize=(13, 2.9))\n","rate = y.mean()\n","segs = [(\"train\", 0, N, MUTED, f\"train  {N:,} rows  |  {int(y.sum()):,} frauds\"),\n","        (\"public\", 0, NPUB, PUB, f\"public LB  ~{NPUB:,} rows\\n~{NPUB * rate:,.0f} frauds\"),\n","        (\"private\", NPUB, NT - NPUB, PRIV, f\"private LB  ~{NT - NPUB:,} rows  |  ~{(NT - NPUB) * rate:,.0f} frauds\")]\n","ax.barh(1, N, color=\"#e6e5df\", height=0.55); ax.text(N / 2, 1, segs[0][4], ha=\"center\", va=\"center\", fontsize=10.5, color=INK)\n","ax.barh(0, NPUB, color=PUB, height=0.55); ax.barh(0, NT - NPUB, left=NPUB + 1500, color=PRIV, height=0.55)\n","ax.text(NPUB / 2, 0, segs[1][4], ha=\"center\", va=\"center\", fontsize=9.5, color=\"white\", fontweight=\"bold\")\n","ax.text(NPUB + (NT - NPUB) / 2, 0, segs[2][4], ha=\"center\", va=\"center\", fontsize=10.5, color=\"white\", fontweight=\"bold\")\n","ax.set_yticks([1, 0]); ax.set_yticklabels([\"train\", \"test\"], fontsize=11); ax.tick_params(axis=\"y\", length=0)\n","ax.set_xlim(0, N * 1.01); ax.grid(False); ax.spines[\"left\"].set_visible(False)\n","ax.xaxis.set_major_formatter(FuncFormatter(lambda v, _: f\"{v / 1000:.0f}k\")); ax.set_xlabel(\"rows\")\n","headline(fig, f\"The public board ranks everyone on about {NPUB * rate:,.0f} frauds\",\n","         \"Public = 20% of the test rows, private = the other 80%. Frauds are estimated from the training fraud rate.\")\n","plt.show()"]},{"cell_type":"markdown","id":"7c1ad1f7","metadata":{"papermill":{"duration":0.012003,"end_time":"2026-11-14T10:27:23.932655+00:00","exception":false,"start_time":"2026-11-14T10:27:23.920652+00:00","status":"completed"},"tags":[]},"source":["<a id=\"s2\"></a>\n","<div style=\"background: #0b1f4b; color: #ffffff; padding: 9px 16px; border-radius: 8px; font-size: 20px; font-weight: 700;\">2 &middot; How noisy is the public LB?</div>\n","\n","Two different questions hide behind \"the public LB is noisy\":\n","\n","* **How far is one file's public score from its private score?** Far: the AUC of a fixed file on ~60k rows with about\n","  a thousand frauds wanders by a few *thousandths*. But every team is scored on the same rows, so this mostly shifts\n","  the whole board together.\n","* **How reliable is the public gap between two files?** This is what decides rankings and ladder steps. Two\n","  files that rank almost every row the same way share most of their noise, so the gap is far less noisy &mdash; but\n","  the gaps at the top are also tiny.\n","\n","We measure both on the nested OOF of the public wide LM stack: draw a public part (~60k rows) and a private part\n","(~240k rows) at random, score every file on both, repeat a few hundred times."]},{"cell_type":"code","execution_count":16,"id":"cf9f8abd","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:27:23.960029Z","iopub.status.busy":"2026-11-14T10:27:23.959511Z","iopub.status.idle":"2026-11-14T10:27:24.470746Z","shell.execute_reply":"2026-11-14T10:27:24.469623Z"},"papermill":{"duration":0.527809,"end_time":"2026-11-14T10:27:24.473104+00:00","exception":false,"start_time":"2026-11-14T10:27:23.945295+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1430x484 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, (ax, ax2) = plt.subplots(1, 2, figsize=(13, 4.4))\n","gap1 = (AUC[0, :, 0] - AUC[0, :, 1]) * 1e5\n","ax.hist(gap1, bins=30, color=MUTED, edgecolor=SURF)\n","ax.set_xlabel(\"public AUC minus private AUC of ONE file (x 1e-5)\"); ax.set_ylabel(\"random splits\"); ax.xaxis.set_major_formatter(E5)\n","panel_title(ax, f\"One file: SD {np.std(gap1):.0f} points\", \"the whole board shares this shift\")\n","iS = NAMES.index(\"GPT-2 seed swap 0.06\")\n","bins_ = np.linspace(min(DELTA[iS, :, 0].min(), DELTA[iS, :, 1].min()), max(DELTA[iS, :, 0].max(), DELTA[iS, :, 1].max()), 36)\n","ax2.hist(DELTA[iS, :, 0], bins=bins_, color=PUB, edgecolor=SURF, alpha=0.9, label=\"public gap\")\n","ax2.hist(DELTA[iS, :, 1], bins=bins_, color=PRIV, edgecolor=SURF, alpha=0.75, label=\"private gap\")\n","ax2.axvline(TRUE[\"GPT-2 seed swap 0.06\"], color=INK, lw=1.5)\n","ax2.text(TRUE[\"GPT-2 seed swap 0.06\"] + 0.3, ax2.get_ylim()[1] * 0.95, f\"nested CV {TRUE['GPT-2 seed swap 0.06']:+.1f}\", fontsize=9, va=\"top\")\n","zero_line(ax2, \"x\"); ax2.xaxis.set_major_formatter(E5); ax2.legend(loc=\"upper left\", fontsize=9)\n","ax2.set_xlabel(\"gap between two consecutive ladder files (x 1e-5)\")\n","panel_title(ax2, f\"Two near-identical files: public SD {SD_PUB[iS]:.1f}, private SD {SD_PRV[iS]:.1f}\",\n","            f\"the GPT-2 seed swap: public gap < 0 in {np.mean(DELTA[iS, :, 0] < 0):.0%} of splits\")\n","headline(fig, f\"One public score swings by +-{np.std(gap1):.0f} points; the gap between two near-identical files by +-{SD_PUB[iS]:.1f}, still more than a rung\",\n","         \"Independent random public (~60k rows) and private (~240k rows) draws from the public wide-stack OOF\")\n","plt.show()"]},{"cell_type":"markdown","id":"84ea2b15","metadata":{"papermill":{"duration":0.013376,"end_time":"2026-11-14T10:27:24.500251+00:00","exception":false,"start_time":"2026-11-14T10:27:24.486875+00:00","status":"completed"},"tags":[]},"source":["### A one-line rule for the noise of a public gap\n","For two files `a` and `b`, the noise of their public gap depends almost only on **how differently they rank the rows**,\n","that is on `1 - rho`, where `rho` is the rank (Spearman) correlation of the two files. Over every move measured here the\n","relation is a clean square root:"]},{"cell_type":"code","execution_count":17,"id":"54049733","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:27:24.52901Z","iopub.status.busy":"2026-11-14T10:27:24.528064Z","iopub.status.idle":"2026-11-14T10:27:25.064142Z","shell.execute_reply":"2026-11-14T10:27:25.063187Z"},"papermill":{"duration":0.554149,"end_time":"2026-11-14T10:27:25.067168+00:00","exception":false,"start_time":"2026-11-14T10:27:24.513019+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1430x572 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, ax = plt.subplots(figsize=(13, 5.2))\n","order_ = np.argsort(ONE_RHO)\n","is_move = np.array([n in MV or n == \"tree move\" for n in NAMES])\n","ax.scatter(ONE_RHO[~is_move], SD_PUB[~is_move], s=36, color=PUB, alpha=0.55, edgecolor=\"none\", label=\"random probe steps (public part)\")\n","ax.scatter(ONE_RHO[is_move], SD_PUB[is_move], s=60, color=PUB, edgecolor=SURF, lw=1.2, label=\"public ladder probes (public part)\")\n","ax.scatter(ONE_RHO, SD_PRV, s=22, color=PRIV, alpha=0.6, edgecolor=\"none\", label=\"the same steps, private part\")\n","xx = np.logspace(np.log10(ONE_RHO.min() * 0.6), np.log10(ONE_RHO.max() * 1.6), 50)\n","ax.plot(xx, K_RULE * np.sqrt(xx) * 1e5, color=NAVY, lw=2)\n","ax.plot(xx, K_RULE * np.sqrt(xx) * 1e5 * np.sqrt(NPUB / (NT - NPUB)), color=PRIV, lw=1.5, ls=(0, (4, 3)))\n","ax.text(xx[-1], K_RULE * np.sqrt(xx[-1]) * 1e5, f\"  public: {K_RULE:.4f} x sqrt(1 - rho)\", va=\"center\", fontsize=10, fontweight=\"bold\", color=NAVY)\n","ax.text(xx[-1], K_RULE * np.sqrt(xx[-1]) * 1e5 * 0.5, \"  private: half of it\", va=\"center\", fontsize=9.5, color=PRIV)\n","if HAVE_LADDER:\n","    for lab, g, orho, sd in STEPS:\n","        ax.axvline(orho, color=RULE, lw=1, zorder=0)\n","    ax.text(max(s[2] for s in STEPS) * 1.08, ax.get_ylim()[0] * 1.15, \"grey lines: consecutive\\npublic ladder files\", fontsize=8.5, color=INK2, va=\"bottom\")\n","ax.set_xscale(\"log\"); ax.set_yscale(\"log\")\n","ax.set_xlabel(\"1 - rank correlation of the two files\"); ax.set_ylabel(\"SD of the gap (x 1e-5)\")\n","ax.set_xlim(xx[0], xx[-1] * 4.5); ax.legend(loc=\"upper left\", fontsize=9)\n","headline(fig, f\"Noise of a public gap = {K_RULE:.4f} x sqrt(1 - rho): about {K_RULE * np.sqrt(1e-4) * 1e5:.0f} points when rho = 0.9999\",\n","         \"Each dot: SD of the gap between the wide-stack OOF and one small move of it, over random 20/80 splits\")\n","plt.show()"]},{"cell_type":"code","execution_count":18,"id":"94d63747","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:27:25.097055Z","iopub.status.busy":"2026-11-14T10:27:25.096255Z","iopub.status.idle":"2026-11-14T10:27:25.103599Z","shell.execute_reply":"2026-11-14T10:27:25.102535Z"},"papermill":{"duration":0.024485,"end_time":"2026-11-14T10:27:25.10554+00:00","exception":false,"start_time":"2026-11-14T10:27:25.081055+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["rho 0.99999   public-gap noise ~   1.5 points   private ~  0.7\n","rho 0.9999    public-gap noise ~   4.7 points   private ~  2.3\n","rho 0.9995    public-gap noise ~  10.5 points   private ~  5.2\n","rho 0.999     public-gap noise ~  14.8 points   private ~  7.4\n","rho 0.995     public-gap noise ~  33.1 points   private ~ 16.5\n"]}],"source":["# Shown: use the rule on your own two submission files (the constant K_RULE was fitted above on public OOF; it assumes\n","# a test set and fraud rate like this competition's, and two files of similar strength).\n","def public_gap_noise(file_a, file_b, k=K_RULE):\n","    \"\"\"1 SD (in AUC) of the public-LB gap between two submissions, from their rank correlation alone.\"\"\"\n","    a = pd.read_csv(file_a)[\"is_fraud\"].to_numpy(); b = pd.read_csv(file_b)[\"is_fraud\"].to_numpy()\n","    rho = np.corrcoef(rankdata(a), rankdata(b))[0, 1]\n","    return k * np.sqrt(max(1 - rho, 0)), rho\n","for r_ in (0.99999, 0.9999, 0.9995, 0.999, 0.995):\n","    print(f\"rho {r_:<8}  public-gap noise ~ {K_RULE * np.sqrt(1 - r_) * 1e5:5.1f} points   private ~ {K_RULE * np.sqrt(1 - r_) * 1e5 / 2:4.1f}\")"]},{"cell_type":"markdown","id":"192098aa","metadata":{"papermill":{"duration":0.014894,"end_time":"2026-11-14T10:27:25.134138+00:00","exception":false,"start_time":"2026-11-14T10:27:25.119244+00:00","status":"completed"},"tags":[]},"source":["<div style=\"background: #eef4fc; border-left: 5px solid #2a78d6; padding: 10px 14px; border-radius: 6px; margin: 6px 0;\">\n","<b>How to read it.</b> Two files with rank correlation 0.9999 have a public gap noise of a few points, about the size\n","of a typical ladder step. A gain of one or two points between such files is <b>not evidence</b> of anything: the same\n","change would show a loss on public in a large share of possible splits. The private gap is half as noisy (four times\n","more rows), so the private board will not simply repeat the public order.\n","</div>"]},{"cell_type":"markdown","id":"c6830403","metadata":{"papermill":{"duration":0.013511,"end_time":"2026-11-14T10:27:25.161476+00:00","exception":false,"start_time":"2026-11-14T10:27:25.147965+00:00","status":"completed"},"tags":[]},"source":["<a id=\"s3\"></a>\n","<div style=\"background: #0b1f4b; color: #ffffff; padding: 9px 16px; border-radius: 8px; font-size: 20px; font-weight: 700;\">3 &middot; Anatomy of a ladder</div>\n","\n","A ladder starts from a strong public file and adds small steps in logit-rank space, keeping each step that the public\n","score rewards. The current public top (0.95354) is built like this, and its authors published **every rung and every\n","probe** (goodpjw2008's *LM Ladder*, Areeb Ali's *Three Ladders*):\n","\n","```\n","s352  = A + 0.6 (A - F) + 0.09 (LM - F) + 0.09 (L7F - F) + 0.05 (GPD - F) - 0.05 (MLP - F) - 0.025 (GB - F)   # 0.95352\n","score = L(s352) + 0.06 (G26 - MS)                                                                            # 0.95354\n","```\n","\n","`A` = Strike 10 (amanatar, 0.95340), `F` = Strike 9 (Moran Z, 0.95330), `LM` = megayak's target-first LM, `L7F` =\n","goodpjw2008's seed-7 LM, `GPD` = daoviet's GP + DVAE, `MLP`/`GB` = two OOF-bank bags, `MS` = masayakawamata's\n","target-first GPT-2, `G26` = a second seed of it (goodpjw2008). The notebook rebuilt this file above from the public\n","inputs and checked it byte for byte against the published one.\n","\n","**The part no one can check.** `A` and `F` publish no OOF predictions, so the base and the extrapolation\n","`0.6 (A - F)` (move further along the direction from Strike 9 to Strike 10) have no out-of-fold check at all. Every\n","other ingredient has public OOF files, so each step can be replayed on a nested OOF, as the ladder authors did\n","themselves. The table collects all of them."]},{"cell_type":"code","execution_count":19,"id":"2b3b8ad0","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:27:25.190986Z","iopub.status.busy":"2026-11-14T10:27:25.190588Z","iopub.status.idle":"2026-11-14T10:27:25.330927Z","shell.execute_reply":"2026-11-14T10:27:25.329962Z"},"papermill":{"duration":0.157684,"end_time":"2026-11-14T10:27:25.332918+00:00","exception":false,"start_time":"2026-11-14T10:27:25.175234+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["All changes in points of 1e-5. Nested CV = applied to the nested OOF of the public wide LM stack (CV 0.952565).\n"]},{"data":{"text/html":["<style type=\"text/css\">\n","</style>\n","<table id=\"T_46307\">\n","  <thead>\n","    <tr>\n","      <th id=\"T_46307_level0_col0\" class=\"col_heading level0 col0\" >probe (step applied to the ladder file)</th>\n","      <th id=\"T_46307_level0_col1\" class=\"col_heading level0 col1\" >public LB change</th>\n","      <th id=\"T_46307_leve