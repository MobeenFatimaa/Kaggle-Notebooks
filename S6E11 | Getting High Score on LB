   </tr>\n","    <tr>\n","      <td id=\"T_ec15f_row3_col0\" class=\"data row3 col0\" >Sameer Shaikh (Part 3)</td>\n","      <td id=\"T_ec15f_row3_col1\" class=\"data row3 col1\" >0.95388 + 5% GP + DVAE</td>\n","      <td id=\"T_ec15f_row3_col2\" class=\"data row3 col2\" >-3</td>\n","      <td id=\"T_ec15f_row3_col3\" class=\"data row3 col3\" >-3.0  [-12.2, +6.2]</td>\n","      <td id=\"T_ec15f_row3_col4\" class=\"data row3 col4\" >not kept: plain noise</td>\n","      <td id=\"T_ec15f_row3_col5\" class=\"data row3 col5\" >-3.1 (1/5 up)</td>\n","      <td id=\"T_ec15f_row3_col6\" class=\"data row3 col6\" >-</td>\n","      <td id=\"T_ec15f_row3_col7\" class=\"data row3 col7\" >no gain on OOF</td>\n","    </tr>\n","    <tr>\n","      <td id=\"T_ec15f_row4_col0\" class=\"data row4 col0\" >Sameer Shaikh (Part 3)</td>\n","      <td id=\"T_ec15f_row4_col1\" class=\"data row4 col1\" >0.95388 + 5% shallow tree</td>\n","      <td id=\"T_ec15f_row4_col2\" class=\"data row4 col2\" >-1</td>\n","      <td id=\"T_ec15f_row4_col3\" class=\"data row4 col3\" >-1.0  [-5.6, +3.6]</td>\n","      <td id=\"T_ec15f_row4_col4\" class=\"data row4 col4\" >not kept: plain noise</td>\n","      <td id=\"T_ec15f_row4_col5\" class=\"data row4 col5\" >+1.6 (4/5 up)</td>\n","      <td id=\"T_ec15f_row4_col6\" class=\"data row4 col6\" >-</td>\n","      <td id=\"T_ec15f_row4_col7\" class=\"data row4 col7\" >tiny gain on OOF; public number is noise</td>\n","    </tr>\n","  </tbody>\n","</table>\n"],"text/plain":["<pandas.io.formats.style.Styler at 0x7f5c47f27100>"]},"execution_count":33,"metadata":{},"output_type":"execute_result"}],"source":["def interval_k1(g, sd):\n","    s = np.sqrt(sd ** 2 + (sd * np.sqrt(NPUB / (NT - NPUB))) ** 2); return g, g - 1.645 * s, g + 1.645 * s\n","VERD = []\n","gp = GIVE[\"goodpjw2008\"]; ga = GIVE[\"Areeb Ali\"]\n","r_base = T9.iloc[0]\n","VERD.append((\"Aman Atar / goodpjw2008\", \"0.95354 -> rank-1 q17 file\", 16, *interval_k1(16, r_base.sd), np.nan, np.nan, \"probes unknown: plain noise\", -1))\n","for lab, gv, fam, oof_n, ref_n in [(\"goodpjw2008\", 16, gp, \"bold\", \"ref\"), (\"Areeb Ali\", 2, ga, \"bold + 0.5 (bold - balanced)\", \"bold\")]:\n","    e = gv - fam[\"back\"]\n","    VERD.append((lab, \"bold mix (best of 5)\" if lab == \"goodpjw2008\" else \"half step (best of 8)\", gv, e.mean(), np.percentile(e, 5), np.percentile(e, 95),\n","                 chg(oof_n, ref_n)[0], NESTED_AUTH.get(oof_n, np.nan), f\"best of {fam['K']}: give-back {fam['back'].mean():+.1f}\", int((chg(oof_n, ref_n)[1] > 0).sum())))\n","for lab, n_, pub in [(\"Sameer Shaikh (Part 3)\", \"388 + 5% GP + DVAE\", -3), (\"Sameer Shaikh (Part 3)\", \"388 + 5% shallow tree\", -1)]:\n","    rr = np.corrcoef(rankdata(PO[n_]), rankdata(MO[\"388\"]))[0, 1]\n","    VERD.append((lab, n_.replace(\"388\", \"0.95388\"), pub, *interval_k1(pub, sig(rr)), chg(n_, \"bold + 0.5 (bold - balanced)\")[0], np.nan, \"not kept: plain noise\",\n","                 int((chg(n_, \"bold + 0.5 (bold - balanced)\")[1] > 0).sum())))\n","VT = pd.DataFrame(VERD, columns=[\"notebook\", \"step\", \"public\", \"exp_private\", \"lo\", \"hi\", \"oof\", \"nested\", \"model\", \"up\"])\n","def verdict(r):\n","    if np.isnan(r.oof): return \"unknown: no OOF\"\n","    if r.oof >= 10 and r.up >= 4: return \"real gain on OOF;\\npublic alone is weak evidence\"\n","    if r.oof > 0 and r.up >= 4: return \"tiny gain on OOF;\\npublic number is noise\"\n","    if r.oof <= 0: return \"no gain on OOF\"\n","    return \"fold noise\"\n","VT[\"verdict\"] = VT.apply(verdict, axis=1)\n","showv = pd.DataFrame({\"notebook\": VT.notebook, \"step\": VT.step, \"public change\": VT.public.map(lambda v: f\"{v:+d}\"),\n","                      \"expected private change (90% interval)\": [f\"{m:+.1f}  [{l:+.1f}, {h:+.1f}]\" for m, l, h in zip(VT.exp_private, VT.lo, VT.hi)],\n","                      \"how\": VT.model, \"OOF change (in-sample)\": [(\"-\" if np.isnan(v) else f\"{v:+.1f} ({u}/5 up)\") for v, u in zip(VT.oof, VT.up)],\n","                      \"authors' nested\": VT.nested.map(lambda v: \"-\" if np.isnan(v) else f\"{v:+.1f}\"), \"verdict\": VT.verdict.str.replace(\"\\n\", \" \")})\n","showv.style.hide(axis=\"index\") if hasattr(showv.style, \"hide\") else showv"]},{"cell_type":"code","execution_count":34,"id":"23bc769d","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:32:07.608443Z","iopub.status.busy":"2026-11-14T10:32:07.608097Z","iopub.status.idle":"2026-11-14T10:32:07.895049Z","shell.execute_reply":"2026-11-14T10:32:07.893906Z"},"papermill":{"duration":0.318429,"end_time":"2026-11-14T10:32:07.897163+00:00","exception":false,"start_time":"2026-11-14T10:32:07.578734+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1430x583 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, ax = plt.subplots(figsize=(13, 5.3))\n","yy = np.arange(len(VT))[::-1]\n","for yi, r in zip(yy, VT.itertuples()):\n","    ax.plot([r.lo, r.hi], [yi - 0.12, yi - 0.12], color=PRIV, lw=3, solid_capstyle=\"round\", alpha=0.45, zorder=2)\n","    ax.plot(r.exp_private, yi - 0.12, \"o\", ms=9, color=PRIV, mec=SURF, mew=1.4, zorder=4)\n","    ax.plot(r.public, yi + 0.14, \"o\", ms=8, color=PUB, mec=SURF, mew=1.4, zorder=4)\n","    if not np.isnan(r.oof): ax.plot(r.oof, yi + 0.14, \"D\", ms=7, color=CV, mec=SURF, mew=1.2, zorder=4)\n","    if not np.isnan(r.nested): ax.plot(r.nested, yi + 0.14, \"D\", ms=7, mfc=SURF, mec=CVTXT, mew=1.6, zorder=5)\n","    ax.text(1.015, yi, r.verdict, va=\"center\", ha=\"left\", fontsize=8.8, color=INK, transform=ax.get_yaxis_transform(), clip_on=False,\n","            fontweight=\"bold\" if r.verdict.startswith(\"real\") else \"normal\")\n","ax.set_yticks(yy); ax.set_yticklabels([f\"{a}\\n{b}\" for a, b in zip(VT.notebook, VT.step)], fontsize=8.8); ax.tick_params(axis=\"y\", length=0)\n","zero_line(ax, \"x\"); ax.xaxis.set_major_formatter(E5); ax.set_xlim(-32, 52); ax.grid(axis=\"y\", visible=False)\n","ax.set_xlabel(\"change vs the file the step was built on (x 1e-5)\")\n","ax.legend(handles=[Line2D([], [], marker=\"o\", ls=\"\", color=PUB, label=\"public change\"),\n","                   Line2D([], [], marker=\"o\", ls=\"-\", color=PRIV, label=\"expected private change, 90% interval\"),\n","                   Line2D([], [], marker=\"D\", ls=\"\", color=CV, label=\"OOF change (in-sample)\"),\n","                   Line2D([], [], marker=\"D\", ls=\"\", mfc=SURF, mec=CVTXT, mew=1.6, label=\"authors' nested CV\")],\n","          loc=\"upper center\", bbox_to_anchor=(0.42, -0.16), ncol=4, fontsize=8.5)\n","headline(fig, \"What each new notebook's public steps are likely to keep on private\",\n","         \"Expected private change = public change minus the give-back of picking the best public probe, simulated on the OOF rows (real 20/80 sizes)\")\n","plt.show()"]},{"cell_type":"markdown","id":"90071231","metadata":{"papermill":{"duration":0.028305,"end_time":"2026-11-14T10:32:07.953366+00:00","exception":false,"start_time":"2026-11-14T10:32:07.925061+00:00","status":"completed"},"tags":[]},"source":["**Reading the verdicts.**\n","\n","* **goodpjw2008's mixes offer real signal.** The bold mix gains on the OOF rows in all five folds and the authors' own\n","  nested CV keeps +19.5 of it. On the board alone, +16 is only about 1.3 noise SDs for a move this size, and keeping\n","  the best of five probes costs about six points in expectation, so the interval is wide; the OOF evidence is what\n","  makes it convincing. This is the strongest new public evidence since v3.\n","* **Areeb Ali's half step is small but real on OOF; the board cannot see it.** On OOF it adds about four points, up on\n","  5 of 5 folds (in-sample, one fold carrying about half of it). A nested choice of the step size also gains, on 4 of 5 folds,\n","  but prefers a longer step (t around 1.5), as the authors found on CV. The public +2 is the best of eight numbers with\n","  a noise of about three points, so the public score itself is no evidence: corrected for the selection, its expected\n","  private value is about -3 (the interval is wide because several of the eight probes are large moves, and any of them\n","  can win a random split). Take the file for the bold mix it contains, not for the last point.\n","* **The base switch has no OOF.** Aman Atar's 0.95370 file is a strong public file whose private value nobody can\n","  check from public data.\n","* **The two Part-3 probes on top of 0.95388** (Sameer Shaikh's team, both lost on the board) lose or barely move on\n","  OOF too: 5% more GP + DVAE loses on 4 of 5 folds, 5% more shallow tree gains under two points. In a file that already\n","  holds a member at a fitted weight, adding more of it does not help.\n","\n","The other new notebooks are not public-tuned ladders, so there is no give-back to estimate:\n","\n","| notebook | what it offers | public tuning |\n","|---|---|---|\n","| Sameer Shaikh, [stack of every public OOF bank](https://www.kaggle.com/code/sameershaikh27/s6e11-fraud-wide-pooled-stack-every-bank-found) | one logistic stack over every public OOF bank on the shared split, scored by nested CV (author: 0.95255) | none: a CV-backed file |\n","| Sameer Shaikh, [Public Submission Fusion (No OOF)](https://www.kaggle.com/code/sameershaikh27/s6e11-fraud-public-submission-fusion-no-oof) | an honest log of file fusions, including probes on top of 0.95388 that lost | every number is public-only, and the author says so |\n","| mathsonchain, [What Worked, What Didn't](https://www.kaggle.com/code/mathsonchain/s6e11-fraud-what-worked-what-didn-t) | a careful progress report and [17 single models with OOF](https://www.kaggle.com/datasets/mathsonchain/s6e11-fraud-oof-test-17-single-models) on the shared split (used in section 12) | none |\n","| denpugovkin, [Scale-Aware Digit GLM](https://www.kaggle.com/code/denpugovkin/s6e11-scale-aware-digit-glm) | a paired, pre-declared experiment on a single GLM | none |\n","| daoviet, [On the journey to your first top 100](https://www.kaggle.com/code/daoviet/s6e11-on-the-journey-to-your-first-top-100) | a beginner-friendly walk through the public ladder and the GP + DVAE member | reproduces public steps |"]},{"cell_type":"markdown","id":"fafa9bb8","metadata":{"papermill":{"duration":0.027779,"end_time":"2026-11-14T10:32:08.008547+00:00","exception":false,"start_time":"2026-11-14T10:32:07.980768+00:00","status":"completed"},"tags":[]},"source":["<a id=\"s11\"></a>\n","<div style=\"background: #0b1f4b; color: #ffffff; padding: 9px 16px; border-radius: 8px; font-size: 20px; font-weight: 700;\">11 &middot; New in v4: error analysis &mdash; which rows do the top files fight over?</div>\n","\n","The OOF rows are the stand-in test set: 699,960 rows with labels, predicted out of fold. Four files are compared on\n","them: the honest **wide LM stack** (nested OOF, goodpjw2008), the **0.95370 replay**, the **bold mix** and the\n","**0.95388 file** (both built on the replay exactly as on test). Every number below is an exact AUC: a step is applied\n","to a **subset of rows only**, and the AUC change of the whole file is read. The subsets are analysis tools; a label\n","based subset (frauds only) could of course never be used to predict."]},{"cell_type":"code","execution_count":35,"id":"9ec6d72c","metadata":{"execution":{"iopub.execute_input":"2026-11-14T10:32:08.067275Z","iopub.status.busy":"2026-11-14T10:32:08.066808Z","iopub.status.idle":"2026-11-14T10:32:08.656279Z","shell.execute_reply":"2026-11-14T10:32:08.655204Z"},"papermill":{"duration":0.622681,"end_time":"2026-11-14T10:32:08.659126+00:00","exception":false,"start_time":"2026-11-14T10:32:08.036445+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["  wide LM stack    OOF AUC 0.952565   frauds caught in the top 1% / 2% / 5% of rows: 40.8% / 56.0% / 73.9%\n","  0.95370 replay   OOF AUC 0.952084   frauds caught in the top 1% / 2% / 5% of rows: 40.8% / 56.0% / 73.7%\n","  bold mix         OOF AUC 0.952412   frauds caught in the top 1% / 2% / 5% of rows: 40.8% / 55.9% / 73.8%\n","  0.95388 file     OOF AUC 0.952455   frauds caught in the top 1% / 2% / 5% of rows: 40.7% / 56.0% / 73.8%\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1430x539 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["for k in EA: print(f\"  {k:16s} OOF AUC {EA_AUC[k]:.6f}   frauds caught in the top 1% / 2% / 5% of rows: \" + \" / \".join(f\"{c:.1%}\" for c in CAPTURE[k]))\n","fig, (ax, ax2) = plt.subplots(1, 2, figsize=(13, 4.9), gridspec_kw=dict(width_ratios=[1, 1.1]))\n","STC = {STEPS_EA[0]: PUB, STEPS_EA[1]: C[6], STEPS_EA[2]: PRIV}\n","STL = {STEPS_EA[0]: \"0.95370 replay -> bold mix\", STEPS_EA[1]: \"bold mix -> 0.95388 file\", STEPS_EA[2]: \"wide LM stack -> 0.95388 file\"}\n","for st, dd in DISAG.items():\n","    full = dd[\"gain\"][-1]\n","    ax.plot(np.array(QGRID) * 100, dd[\"gain\"], \"o-\", color=STC[st], ms=5, lw=2, label=f\"{STL[st]}  (all rows {full:+.1f})\")\n","ax.set_xscale(\"log\"); ax.set_xticks([0.5, 1, 2, 5, 10, 20, 50, 100]); ax.set_xticklabels([\"0.5\", \"1\", \"2\", \"5\", \"10\", \"20\", \"50\", \"100\"])\n","zero_line(ax); ax.yaxis.set_major_formatter(E5); ax.legend(loc=\"upper left\", fontsize=8.5)\n","ax.set_xlabel(\"% of rows that take the new file's rank (most-moved rows first)\"); ax.set_ylabel(\"AUC change of the whole file (x 1e-5)\")\n","panel_title(ax, \"The change is spread over many rows\", \"rows ranked by how far the step moves them; the most-moved are mostly legit rows\")\n","seg = SEG_TAB[(SEG_TAB.segmentation == \"score band (rank in the base file)\")]\n","bands = [\"bottom 80%\", \"80-95%\", \"95-99%\", \"top 1%\"]\n","x = np.arange(len(bands)); wdt = 0.26\n","for i, st in enumerate(STEPS_EA):\n","    v = [seg[(seg.step == f\"{st[0]} -> {st[1]}\") & (seg.segment == b)].gain.iloc[0] for b in bands]\n","    ax2.bar(x + (i -